# Apache settings for shared hosting. The app is index.cgi; static files are served directly.
Options +ExecCGI -Indexes
AddHandler cgi-script .cgi
DirectoryIndex index.html
AddType text/javascript .mjs
AddType application/wasm .wasm

<IfModule mod_rewrite.c>
RewriteEngine On
# Keep source, tests and any config file private.
RewriteRule ^(app|tests|tools|docs|\.git|\.github)(/|$) - [F,L]
RewriteRule ^(config.*\.json|.*\.py|.*\.md|\.cpanel\.yml|\.gitignore)$ - [F,L]
# Send API calls to the CGI script.
RewriteRule ^api/(.*)$ index.cgi/api/$1 [QSA,L]
</IfModule>
